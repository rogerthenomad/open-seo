{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "run-your-seo-landing",
  "compatibility_date": "2026-02-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // The marketing site serves at seo.capturethatmedia.com. A `custom_domain`
  // route fails the deploy unless capturethatmedia.com is a zone in the
  // deploying Cloudflare account. No www alias: www.seo.capturethatmedia.com
  // is a second level subdomain that universal SSL does not cover.
  "routes": [
    {
      "pattern": "seo.capturethatmedia.com",
      "custom_domain": true,
    },
  ],
  "env": {
    "preview": {
      "name": "run-your-seo-landing-preview",
      "workers_dev": true,
      "preview_urls": true,
    },
  },
}
